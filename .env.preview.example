# Isolated CQA Preview configuration. Commit this example with empty credentials only.
# Copy to .env.preview.local for local use, or enter values in Vercel Preview.
# Never assign these test values to Production.
NEXT_PUBLIC_SITE_URL=

# Supabase: CQA Launch Test
SUPABASE_URL=https://ndzmlywsuywkhgqdbzft.supabase.co
