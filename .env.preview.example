# Isolated CQA Preview configuration. Commit this example with empty credentials only.
# Enter these values in Vercel Preview for isolated hosted verification.
# Ordinary next dev loads .env.local, not .env.preview.local; start with .env.local.example.
# Never assign these test values to Production.
NEXT_PUBLIC_SITE_URL=

# Preview-only acknowledgement required by the sandbox checkout gate.
CQA_COMMERCE_TEST_PROJECT=ndzmlywsuywkhgqdbzft

# Supabase: CQA Launch Test
SUPABASE_URL=https://ndzmlywsuywkhgqdbzft.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ndzmlywsuywkhgqdbzft.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative modern server secret; server only.
SUPABASE_SECRET_KEY=

# Stripe: CQA Isolated Launch Test. Use test keys and test price IDs only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect endpoint: /api/marketplace/stripe-webhook
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASIC=price_1UZJGdP6kjGSpjgkgtCToG5C
STRIPE_PRICE_PRO=price_1UZJGeP6kjGSpjgk35UyW5Zr
STRIPE_PRICE_ELITE=price_1UZJGfP6kjGSpjgknHtmrnZn
# Legacy subscription product is separate from the three machine plans; leave unset until defined.
STRIPE_PRICE_SUBSCRIPTION=
CQA_CUSTOMER_LAUNCH_APPROVED=false
CQA_DIGITAL_DELIVERY_APPROVED=false

# Existing private R2 bucket. Do not enable public access for paid downloads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional legacy public media only. Leave empty for protected digital delivery.
R2_PUBLIC_URL=

# Controlled integration checks: no arguments performs configuration preflight.
# Use the independently verified isolated Preview deployment and fixture IDs.
CQA_TEST_BASE_URL=
CQA_TEST_SUPABASE_URL=https://ndzmlywsuywkhgqdbzft.supabase.co
CQA_TEST_CANDIDATE_SHA=
CQA_TEST_ISOLATION_ACK=ndzmlywsuywkhgqdbzft
CQA_TEST_R2_ACCOUNT_ID=
CQA_TEST_R2_BUCKET=
CQA_TEST_BUSINESS_ID=
CQA_TEST_OFFER_ID=
CQA_TEST_ORDER_ID=
CQA_TEST_ASSET_SHA256=
CQA_TEST_SUPABASE_ANON_KEY=
# Three distinct confirmed test users: owner, buyer A, buyer B.
CQA_TEST_OWNER_TOKEN=
CQA_TEST_BUYER_A_TOKEN=
CQA_TEST_BUYER_B_TOKEN=

# Enable only after inventory, merchant dispatch and payment acceptance tests.
CQA_PHYSICAL_DELIVERY_APPROVED=false

# Branch-scoped Preview supplier pilot, after test migration and isolation checks.
CQA_SUPPLIER_PILOT_ENABLED=false
# Optional mock quote overrides (whole units, or AUD cents).
CQA_MOCK_SUPPLIER_STOCK=
CQA_MOCK_SUPPLIER_UNIT_COST_CENTS=
CQA_MOCK_SUPPLIER_SHIPPING_CENTS=
# Server-only CJ credential. Leave unset for the mock-first pilot.
CQA_CJ_API_KEY=
