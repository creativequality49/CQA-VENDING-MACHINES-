CQA_DIGITAL_DELIVERY_APPROVED=false

# Existing private R2 bucket. Do not enable public access for paid downloads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
