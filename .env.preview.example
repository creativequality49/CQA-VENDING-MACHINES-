# Stripe: CQA Isolated Launch Test. Use test keys and test price IDs only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect endpoint: /api/marketplace/stripe-webhook
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
