# Copy to .env.local. Next.js loads that filename automatically in local dev.
# Empty credentials are intentional. Use an isolated project for real testing.
# Do not copy production secrets or approve customer launch/delivery for local tests.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Supabase: supply one isolated project's matching server and browser URLs.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Payments remain held; ordinary localhost is not isolated Vercel Preview.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_SUBSCRIPTION=
CQA_CUSTOMER_LAUNCH_APPROVED=false
CQA_DIGITAL_DELIVERY_APPROVED=false
CQA_COMMERCE_TEST_PROJECT=

# Private object storage for protected paid-content delivery.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional generation, lead capture and automation services.
OPENAI_API_KEY=
CQA_CHAT_API_URL=
CQA_CHAT_API_KEY=
CQA_CHAT_MODEL=
CQA_EMBEDDINGS_API_URL=
CQA_EMBEDDING_API_KEY=
CQA_EMBEDDING_MODEL=
CQA_MEDIA_API_URL=
CQA_MEDIA_API_KEY=
CQA_IMAGE_MODEL=
CQA_VIDEO_MODEL=
VIDEO_USE_WORKER_URL=
VIDEO_USE_WORKER_SECRET=
GOOGLE_PLACES_API_KEY=
CQA_LEAD_MACHINE_ACCESS_KEY=
RESEND_API_KEY=
CQA_AUTOMATION_FROM_EMAIL=
CQA_WEBHOOK_ALLOWLIST=
CRON_SECRET=

# Age assurance must be validated before restricted content can be unlocked.
YOTI_AGE_API_KEY=
YOTI_SDK_ID=
AGE_GATE_SECRET=
SAFETY_REPORT_EMAIL=

# Optional legacy Fanvue integration.
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=http://localhost:3000/api/fanvue/callback
FANVUE_SCOPES=read:self
FANVUE_SESSION_SECRET=
FANVUE_API_KEY=
